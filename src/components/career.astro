---
// Import your data and the new component at the top of the file
import { Icon } from 'astro-icon/components';
import careerData from '../data/career.json';
import CareerCard from './career-card.astro';

const VISIBLE_LIMIT = 4;
const hasOverflow = careerData.length > VISIBLE_LIMIT;
---

<section id="career" class="section-container max-w-6xl mx-auto overflow-hidden">
  <div class="container mx-auto reveal-content" style="animation-delay: 1000ms;">
    <div>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-8 flex items-center gap-4">
        <span class="text-accent">/</span> Career
      </h2>
    </div>

    <div class="relative">
      {/* Vertical Line*/}
      <div class="absolute left-2 md:left-1/2 md:-translate-x-1/2 top-5 bottom-0 w-0.5 bg-linear-to-b from-accent via-white/10 to-transparent"></div>

      {/* Mobile View */}
      <div class="md:hidden space-y-8">
        {careerData.map((item, index) => (
          <div class={`scroll-stat relative pl-6 ${index >= VISIBLE_LIMIT ? 'hidden-by-limit' : ''}`} data-index={index}>
            {/* Dot for mobile view*/}
            <div class="absolute left-0 top-1 z-10">
              <div class={`w-4 h-4 rounded-full border-4 border-[#0a0a0a]
                          ${index === 0 ? 'bg-accent shadow-[0_0_15px_var(--color-accent)] animate-pulse' : 'bg-accent/50'}`}>
              </div>
            </div>

            <CareerCard item={item} variant="mobile" />
          </div>
        ))}
      </div>

      {/* Desktop View */}
      <div class="hidden md:block space-y-4">
        {careerData.map((item, index) => (
          <div class={`scroll-stat relative grid grid-cols-2 ${index >= VISIBLE_LIMIT ? 'hidden-by-limit' : ''}`} data-index={index}>
            {/* Center Dot */}
            <div class="absolute left-1/2 -translate-x-1/2 top-1 z-10">
              <div class={`w-4 h-4 rounded-full border-4 border-[#0a0a0a]
                          ${index === 0 ? 'bg-accent shadow-[0_0_15px_var(--color-accent)] animate-pulse' : 'bg-accent/50'}`}>
              </div>
            </div>

            {/* Left Side (even items) */}
            <div class="md:px-6 md:py-0">
              {index % 2 === 0 ? (
                <CareerCard item={item} variant="desktop-left" />
              ) : <div class="h-full pointer-events-none"></div>}
            </div>

            {/* Right Side (odd items) */}
            <div class="md:px-6 md:py-0">
              {index % 2 !== 0 ? (
                <CareerCard item={item} variant="desktop-right" />
              ) : <div class="h-full pointer-events-none"></div>}
            </div>
          </div>
        ))}
      </div>

      {hasOverflow && (
        <div id="career-see-more-wrap" class="relative -mt-4 pt-16">
          <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-t from-background to-transparent"></div>
          <div class="relative flex justify-center">
            <button id="career-see-more-btn" class="career-see-more-btn">
              See More
              <Icon name="mdi:chevron-down" class="w-4 h-4" />
            </button>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Reveal whole section when website loads */
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Initial state of the card */
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Revealed state while scrolling*/
  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .scroll-stat.hidden-by-limit {
    display: none !important;
  }

  .career-see-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.4rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
    background: var(--color-background);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .career-see-more-btn:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Add a slight delay based on the card's position to create a wave effect
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); // Delay resets every row for a clean staggered look
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15, // Trigger when 15% of the card is visible
      rootMargin: '0px 0px -10px 0px' // Trigger slightly before it hits the viewport
    });

    cards.forEach(card => observer.observe(card));
  }

  function initSeeMore() {
    const wrap = document.getElementById('career-see-more-wrap');
    const btn = document.getElementById('career-see-more-btn');
    if (!wrap || !btn) return;

    btn.addEventListener('click', () => {
      document.querySelectorAll('.scroll-stat.hidden-by-limit').forEach((card) => {
        card.classList.remove('hidden-by-limit');
        card.classList.add('reveal');
      });
      wrap.remove();
    });
  }

  // Runs on initial load
  revealCards();
  initSeeMore();

  // Necessary for Astro View Transitions if you use them
  document.addEventListener('astro:after-swap', revealCards);
  document.addEventListener('astro:after-swap', initSeeMore);
</script>
