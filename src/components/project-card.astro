---
import { Icon } from 'astro-icon/components';
const { project } = Astro.props;
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../utils/images';
import ProjectVisual from './project-visual.astro';

// Map through the array of image strings from project JSON
const optimizedImages = await Promise.all(
  project.images.map(async (imgName: string) => {
    return await resolveAssetImage(imgName);
  })
);

const validImages = optimizedImages.filter(Boolean);

const isSlider = validImages.length > 1;

const categoryColors: Record<string, string> = {
  'AI Initiative':        'text-violet-400 bg-violet-400/10 border-violet-400/20',
  'Quality Engineering':  'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
  'Cloud Migration':      'text-sky-400 bg-sky-400/10 border-sky-400/20',
  'Digital Platform':     'text-fuchsia-400 bg-fuchsia-400/10 border-fuchsia-400/20',
  'Enterprise Platform':  'text-amber-400 bg-amber-400/10 border-amber-400/20',
  'Security Initiative':  'text-rose-400 bg-rose-400/10 border-rose-400/20',
};
const categoryClass = categoryColors[project.category] ?? 'text-accent bg-accent/10 border-accent/20';

const platformLabels: Record<string, string> = {
  domain: 'Enterprise',
  web: 'Web',
};

const platformIconMap: Record<string, string> = {
  domain: 'mdi:domain',
  web: 'mdi:web',
};
---

<div class="project-card group relative bg-accent/5 border border-accent/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500">
  <div class="aspect-video overflow-hidden relative bg-background/50">
    <div class="absolute inset-0 bg-accent/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
    
    <div class={`w-full h-full relative ${isSlider ? 'image-slider' : ''}`}>
      {
        validImages.length > 0 ? (
          validImages.map((imgMetadata, index) => (
            <Image
              src={imgMetadata}
              alt={`${project.title}`}
              class={`absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110 ${index === 0 ? "opacity-100 z-0" : "opacity-0 z-[-1]"}`}
            />
          ))
        ) : (
          /* No real image supplied: render a stylized abstract visual instead */
          <ProjectVisual icon={project.visualIcon} />
        )
      }
    </div>
    
    <div class="absolute top-3 right-3 flex gap-2 z-20">
      {project.platforms.map((p: string) => (
        <div
          class="p-1.5 bg-background backdrop-blur-md rounded-lg border border-accent/10 text-maintext"
          title={platformLabels[p] ?? p}
        >
          <Icon name={platformIconMap[p] ?? `mdi:${p}`} class="w-4 h-4" />
        </div>
      ))}
    </div>

    {isSlider && (
      <div class="slider-dots absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-30">
        {validImages.map((_: unknown, i: number) => (
          <span class={`slider-dot block rounded-full transition-all duration-400 ${i === 0 ? 'w-4 h-1.5 bg-white' : 'w-1.5 h-1.5 bg-white/40'}`} />
        ))}
      </div>
    )}
  </div>

  <div class="p-6 space-y-4">
    <div>
      <span class={`inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border ${categoryClass}`}>
        {project.category}
      </span>
      <h3 class="text-xl font-heading font-bold text-maintext mt-2">{project.title}</h3>
    </div>

    <div>
      <p class="project-desc text-subtext text-sm font-body line-clamp-3">
        {project.description}
      </p>
      <button type="button" class="show-more-btn hidden mt-1 text-xs font-semibold text-accent hover:underline cursor-pointer">
        Show more
      </button>
    </div>

    <div class="flex flex-wrap gap-2 pt-2">
      {project.tech.map((t: string) => (
        <span class="rounded-md text-[10px] px-2 md:px-4 py-1 bg-accent/5 border border-accent/10 text-accent/80  group-hover:border-accent/40 group-hover:text-accent">
          {t}
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  const activeSliderIntervals: ReturnType<typeof setInterval>[] = [];

  function initSliders() {
    activeSliderIntervals.forEach(clearInterval);
    activeSliderIntervals.length = 0;

    const sliders = document.querySelectorAll('.image-slider');

    sliders.forEach(slider => {
      const images = slider.querySelectorAll('img');
      if (images.length <= 1) return;

      const card = slider.closest('.project-card');
      const dots = card ? card.querySelectorAll('.slider-dot') : [];

      let currentIndex = 0;
      const id = setInterval(() => {
        // Hide current
        images[currentIndex].classList.remove('opacity-100', 'z-0');
        images[currentIndex].classList.add('opacity-0', 'z-[-1]');
        if (dots[currentIndex]) {
          dots[currentIndex].classList.remove('w-4', 'bg-white');
          dots[currentIndex].classList.add('w-1.5', 'bg-white/40');
        }

        // Move to next
        currentIndex = (currentIndex + 1) % images.length;

        // Show next
        images[currentIndex].classList.remove('opacity-0', 'z-[-1]');
        images[currentIndex].classList.add('opacity-100', 'z-0');
        if (dots[currentIndex]) {
          dots[currentIndex].classList.remove('w-1.5', 'bg-white/40');
          dots[currentIndex].classList.add('w-4', 'bg-white');
        }
      }, 3500);

      activeSliderIntervals.push(id);
    });
  }

  initSliders();
  document.addEventListener('astro:after-swap', initSliders);

  function checkDescriptionTruncation() {
    document.querySelectorAll('.project-desc').forEach((desc) => {
      if (desc.classList.contains('expanded')) return;
      const btn = desc.nextElementSibling as HTMLElement | null;
      if (!btn || !btn.classList.contains('show-more-btn')) return;
      const isTruncated = desc.scrollHeight > desc.clientHeight + 1;
      btn.classList.toggle('hidden', !isTruncated);
    });
  }

  function initReadMore() {
    document.querySelectorAll('.show-more-btn').forEach((el) => {
      const btn = el as HTMLElement;
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';

      const desc = btn.previousElementSibling as HTMLElement;
      btn.addEventListener('click', () => {
        const expanded = desc.classList.toggle('expanded');
        desc.classList.toggle('line-clamp-3', !expanded);
        btn.textContent = expanded ? 'Show less' : 'Show more';
      });
    });

    checkDescriptionTruncation();
  }

  initReadMore();
  document.addEventListener('astro:after-swap', initReadMore);

  // Web fonts (Inter Variable) can finish loading after the initial check
  // above runs, causing text to re-wrap and change line count. Re-check
  // once fonts are confirmed loaded so a slow/cold font load doesn't leave
  // a truncated description without its "Show more" button.
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(checkDescriptionTruncation);
  }

  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(checkDescriptionTruncation, 150);
  });
</script>

<style is:global>
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition: 
      opacity 0.8s ease-out, 
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>